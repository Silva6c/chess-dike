<?xml version="1.0" encoding="utf-8"?>
<!-- 主页次按钮：半透明底 + 1dp 描边（描边分层代替阴影）；按压整体提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="#1F1A2230" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="@color/qi_line2" />
            <stroke
                android:width="1dp"
                android:color="@color/qi_line3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="@color/qi_line1" />
            <stroke
                android:width="1dp"
                android:color="@color/qi_line2" />
        </shape>
    </item>
</selector>
