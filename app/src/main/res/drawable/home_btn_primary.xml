<?xml version="1.0" encoding="utf-8"?>
<!-- 主页主按钮：朱砂·按 #C35440（白字对比 4.5:1）；按压加深，禁用暗灰 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="#33262B38" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="@color/qi_zhu_btn_press" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_m" />
            <solid android:color="@color/qi_zhu_btn" />
        </shape>
    </item>
</selector>
