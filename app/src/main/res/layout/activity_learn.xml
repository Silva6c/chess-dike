<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xq_paper"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- 状态行：左边状态文字，右边我方视角分值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_learn_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/xq_ink_text"
                android:text="轮到你走"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_learn_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFeatureSettings="tnum"
                android:text=""
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 河界线装饰（静态朱砂，品牌一致性） -->
        <com.xqdk.chess.assist.ui.RiverLineView
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp" />

        <!-- 对局棋盘（纵横比 1240:1340 由视图自锁） -->
        <com.xqdk.chess.learn.LearnBoardView
            android:id="@+id/learn_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- 三解指导文案行（CORRECTION 态显示） -->
        <TextView
            android:id="@+id/tv_solutions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/xq_muted"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <!-- 走势曲线卡片（step_row_bg：卡片面 + 1dp 描边） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/step_row_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/xq_muted"
                android:text="走势曲线（我方视角 · 均势为中线）"
                tools:ignore="HardcodedText" />

            <com.xqdk.chess.learn.TrendChartView
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 终局文案（GAME_OVER 态显示） -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/xq_ink_text"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <!-- 操作行：开新局 / 悔棋 / 执方切换（线框款，主按钮同源描边） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_new_game"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/main_btn_outline"
                android:backgroundTint="@null"
                android:textSize="13sp"
                android:textColor="@color/xq_zhu"
                android:stateListAnimator="@null"
                android:text="开新局"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_undo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/main_btn_outline"
                android:backgroundTint="@null"
                android:textSize="13sp"
                android:textColor="@color/xq_zhu"
                android:stateListAnimator="@null"
                android:text="悔棋"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_side"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/main_btn_outline"
                android:backgroundTint="@null"
                android:textSize="13sp"
                android:textColor="@color/xq_zhu"
                android:stateListAnimator="@null"
                android:text="执红"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
