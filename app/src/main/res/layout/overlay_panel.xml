<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- 左列：状态多行小字为主体（maxLines 封顶防溢出）+ 一行低频小按钮。
         列高不再死锁 171dp，由内容自然撑起（棋盘 171dp 主导面板高度） -->
    <LinearLayout
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="118dp"
            android:ellipsize="end"
            android:maxLines="8"
            android:text="识别中…"
            android:textColor="#FFE082"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlay_btn_change"
                style="@style/OverlayButton"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="2dp"
                android:gravity="center"
                android:paddingHorizontal="0dp"
                android:text="变招" />

            <TextView
                android:id="@+id/overlay_btn_undo"
                style="@style/OverlayButton"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="2dp"
                android:gravity="center"
                android:paddingHorizontal="0dp"
                android:text="悔棋" />

            <TextView
                android:id="@+id/overlay_btn_manual"
                style="@style/OverlayButton"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="2dp"
                android:gravity="center"
                android:paddingHorizontal="0dp"
                android:text="手动" />
        </LinearLayout>
    </LinearLayout>

    <com.xqdk.chess.assist.ui.OverlayChessView
        android:id="@+id/overlay_chess"
        android:layout_width="158dp"
        android:layout_height="171dp"
        android:layout_marginHorizontal="4dp" />

    <!-- 右列：5 个等宽等高按钮（wrap_content 宽在悬浮窗测量下会被压成竖排，必须固定宽） -->
    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_btn_strength"
            style="@style/OverlayButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:text="深度20" />

        <TextView
            android:id="@+id/overlay_btn_hash"
            style="@style/OverlayButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:text="Hash256" />

        <TextView
            android:id="@+id/overlay_btn_turn"
            style="@style/OverlayButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:text="更新棋局" />

        <TextView
            android:id="@+id/overlay_btn_pause"
            style="@style/OverlayButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:text="停止" />

        <TextView
            android:id="@+id/overlay_btn_close"
            style="@style/OverlayButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:text="关闭" />
    </LinearLayout>
</LinearLayout>
